{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reprogate.dev/schemas/git-promotion-evidence-v1.json",
  "title": "ReproGate Git promotion evidence bundle v1",
  "$comment": "A host-signed, content-addressed bundle for one resolved promotion attempt. manifestDigest is sha256 over the canonical JSON of manifest; the Ed25519 signature covers the UTF-8 bytes of 'reprogate.git-promotion-evidence.v1\\n' followed by manifestDigest. The attempt omits the host's repository path and fence owner. Cross-record bindings, canonical form, review authentication and the effect checks require the verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleVersion", "manifest", "manifestDigest", "signature"],
  "properties": {
    "bundleVersion": {
      "const": 1
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestVersion",
        "attemptId",
        "repositoryId",
        "destinationRef",
        "review",
        "attempt",
        "outcome",
        "coverage",
        "exportedAt",
        "hostKeyId"
      ],
      "properties": {
        "manifestVersion": {
          "const": 1
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "destinationRef": {
          "type": "string",
          "pattern": "^refs/heads/"
        },
        "review": {
          "$ref": "https://reprogate.dev/schemas/git-operator-review-v1.json"
        },
        "attempt": {
          "type": "object",
          "required": [
            "attemptVersion",
            "state",
            "attemptId",
            "approvalId",
            "proposalId",
            "reviewDigest",
            "authorityDigest",
            "effectDigest",
            "proposal",
            "prepared",
            "authority",
            "precheckedAt",
            "reservedAt",
            "admissionDeadline"
          ],
          "properties": {
            "attemptVersion": {
              "const": 1
            },
            "state": {
              "const": "prepared"
            },
            "attemptId": {
              "type": "string"
            },
            "approvalId": {
              "type": "string"
            },
            "proposalId": {
              "$ref": "#/$defs/digest"
            },
            "reviewDigest": {
              "$ref": "#/$defs/digest"
            },
            "authorityDigest": {
              "$ref": "#/$defs/digest"
            },
            "effectDigest": {
              "$ref": "#/$defs/digest"
            },
            "proposal": {
              "type": "object"
            },
            "prepared": {
              "type": "object"
            },
            "authority": {
              "type": "object"
            },
            "precheckedAt": {
              "type": "string"
            },
            "reservedAt": {
              "type": "string"
            },
            "admissionDeadline": {
              "type": "string"
            }
          },
          "$comment": "The full attempt record minus the host's repository path and fence owner, which additionalProperties forbids. The verifier checks every nested field and binding.",
          "additionalProperties": false
        },
        "admission": {
          "$ref": "https://reprogate.dev/schemas/git-promotion-admission-v1.json"
        },
        "outcome": {
          "$ref": "https://reprogate.dev/schemas/git-promotion-outcome-v1.json"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gitRef",
            "candidateObjects",
            "filesystem",
            "process",
            "network",
            "credentials"
          ],
          "properties": {
            "gitRef": {
              "const": "enforced"
            },
            "candidateObjects": {
              "const": "observed"
            },
            "filesystem": {
              "const": "not_covered"
            },
            "process": {
              "const": "not_covered"
            },
            "network": {
              "const": "not_covered"
            },
            "credentials": {
              "const": "not_covered"
            }
          }
        },
        "exportedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "hostKeyId": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
